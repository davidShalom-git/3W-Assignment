{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/room-showcase/index.html" },
    { "source": "/qr", "destination": "/room-showcase/qr.html" },
    { "source": "/qr.html", "destination": "/room-showcase/qr.html" },
    { "source": "/card", "destination": "/room-showcase/card.html" },
    { "source": "/card.html", "destination": "/room-showcase/card.html" },
    { "source": "/css/:match*", "destination": "/room-showcase/css/:match*" },
    { "source": "/js/:match*", "destination": "/room-showcase/js/:match*" },
    { "source": "/assets/:match*", "destination": "/room-showcase/assets/:match*" },
    { "source": "/:match*", "destination": "/room-showcase/:match*" }
  ]
}
